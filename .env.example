# =====================
# Environment
# =====================
APP_ENV=dev
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# =====================
# MongoDB
# =====================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=linkedin_engine

# =====================
# Redis
# =====================
REDIS_URL=redis://localhost:6379/0

# =====================
# JWT (auth cookies)
# =====================
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# =====================
# RULE 23 atomic gate (Phase 3)
# =====================
RULE_23_PEPPER=change-me-in-prod-and-rotate

# =====================
# OpenAI (Phase 2+)
# =====================
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5.4
OPENAI_MODEL_CHEAP=gpt-5.4-mini

# =====================
# apidirect.io (Phase 3)
# =====================
APIDIRECT_API_KEY=

# =====================
# Resend email (Phase 3)
# =====================
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@yourdomain.com

# =====================
# Crustdata watcher → POST /api/webhooks/crustdata (discovery inbox)
# =====================
# CRUSTDATA_WEBHOOK_BASE_URL must be a public HTTPS origin (Crustdata cannot call localhost).
# Dev: run `ngrok http 8000`, copy the https://….ngrok-free.app URL here (no path).
# One-shot check (needs dashboard authtoken): export NGROK_AUTHTOKEN=… && ./scripts/ngrok-webhook-health.sh
# NGROK_AUTHTOKEN=
CRUSTDATA_API_KEY=
CRUSTDATA_WEBHOOK_BASE_URL=
CRUSTDATA_WEBHOOK_SECRET=

# =====================
# Discovery (optional)
# =====================
# When true (default), empty Crustdata inbox on the first discovery pass of a slate run
# triggers one simulation POST per cofounder (top-up rounds skip this).
# DISCOVERY_CRUSTDATA_SIMULATION_PING_ON_EMPTY_INBOX=true
# Realtime keyword posts via Crustdata screener (sync HTTP); caps below limit spend.
# DISCOVERY_USE_CRUSTDATA_SCREENER=true
# DISCOVERY_CRUSTDATA_SCREENER_MAX_KEYWORD_CALLS=5
# DISCOVERY_CRUSTDATA_SCREENER_LIMIT_PER_KEYWORD=8
# DISCOVERY_CRUSTDATA_SCREENER_DATE_POSTED=past-month

# =====================
# Calendly webhooks (Phase 5)
# =====================
CALENDLY_WEBHOOK_BASE_URL=http://localhost:8000/api/webhooks/calendly

# =====================
# Frontend (Next.js)
# =====================
NEXT_PUBLIC_API_URL=http://localhost:8000
