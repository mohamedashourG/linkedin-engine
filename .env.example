# =====================
# Environment
# =====================
APP_ENV=dev
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# =====================
# MongoDB
# =====================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=linkedin_engine

# =====================
# Redis
# =====================
REDIS_URL=redis://localhost:6379/0

# Celery task time limits (seconds). Hard must exceed soft.
# Defaults: global 1500/1800; daily_run + nightly_run use pipeline 3600/3900 (see celery_app).
# Raise pipeline values if discovery budgets or slow LLM upstreams routinely exceed an hour.
# CELERY_TASK_SOFT_TIME_LIMIT_S=1500
# CELERY_TASK_TIME_LIMIT_S=1800
# CELERY_PIPELINE_SOFT_TIME_LIMIT_S=3600
# CELERY_PIPELINE_TIME_LIMIT_S=3900

# =====================
# JWT (auth cookies)
# =====================
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# =====================
# RULE 23 atomic gate (Phase 3)
# =====================
RULE_23_PEPPER=change-me-in-prod-and-rotate
# SKIP_RULE_23=false

# =====================
# OpenAI (Phase 2+)
# =====================
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5.4
OPENAI_MODEL_CHEAP=gpt-5.4-mini

# =====================
# Azure OpenAI (optional — if set, used when OPENAI_API_KEY is empty)
# =====================
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT_PRIMARY=gpt-5.4
# AZURE_OPENAI_DEPLOYMENT_CHEAP=gpt-4.1

# =====================
# apidirect.io (Phase 3)
# =====================
APIDIRECT_API_KEY=
# APIDIRECT_MOCK=false
# DISCOVERY_APIDIRECT_MAX_PAGES=4
# DISCOVERY_APIDIRECT_FETCH_POST_DETAILS=false
# DISCOVERY_APIDIRECT_POST_DETAILS_GET_SENTIMENT=false

# =====================
# Resend email (Phase 3)
# =====================
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@yourdomain.com

# =====================
# Crustdata watcher → POST /api/webhooks/crustdata (discovery inbox)
# =====================
# CRUSTDATA_WEBHOOK_BASE_URL must be a public HTTPS origin (Crustdata cannot call localhost).
# Dev: run `ngrok http 8000`, copy the https://….ngrok-free.app URL here (no path).
# One-shot check (needs dashboard authtoken): export NGROK_AUTHTOKEN=… && ./scripts/ngrok-webhook-health.sh
# NGROK_AUTHTOKEN=
CRUSTDATA_API_KEY=
CRUSTDATA_WEBHOOK_BASE_URL=
CRUSTDATA_WEBHOOK_SECRET=

# =====================
# Discovery (optional)
# =====================
# When true (default), empty Crustdata inbox on the first discovery pass of a slate run
# triggers one simulation POST per cofounder (top-up rounds skip this).
# DISCOVERY_CRUSTDATA_SIMULATION_PING_ON_EMPTY_INBOX=true
# Realtime keyword posts via Crustdata screener (sync HTTP); caps below limit spend.
# DISCOVERY_USE_CRUSTDATA_SCREENER=true
# DISCOVERY_CRUSTDATA_SCREENER_MAX_KEYWORD_CALLS=5
# DISCOVERY_CRUSTDATA_SCREENER_LIMIT_PER_KEYWORD=8
# DISCOVERY_CRUSTDATA_SCREENER_DATE_POSTED=past-month
# Unipile classic post search: optional LinkedIn location geo IDs (comma-separated).
# When DISCOVERY_UNIPILE_POST_LOCATION_IDS is empty and DISCOVERY_UNIPILE_POST_RESOLVE_LOCATION=true,
# discovery resolves the first operator geography string via GET /linkedin/search/parameters.
# DISCOVERY_UNIPILE_POST_LOCATION_IDS=103644278
# DISCOVERY_UNIPILE_POST_RESOLVE_LOCATION=true
# Omit company-authored posts from Unipile keyword + title-search paths (default true).
# DISCOVERY_UNIPILE_SKIP_COMPANY_POSTS=true
# RULE 24 people search: default LinkedIn geoUrn id(s), comma-separated. Empty = US (103644278).
# UNIPILE_RULE24_LOCATION_IDS=103644278
# UNIPILE_API_KEY=
# UNIPILE_SUBDOMAIN=
# UNIPILE_PORT=443
# UNIPILE_MOCK=false
# Discovery source toggles
# DISCOVERY_USE_APIDIRECT=true
# DISCOVERY_USE_CRUSTDATA=true
# DISCOVERY_USE_UNIPILE=true
# DISCOVERY_USE_EXA=true
# DISCOVERY_USE_TITLE_SEARCH=true
# DISCOVERY_USE_BRIGHTDATA=false
# DISCOVERY_KEYWORD_HISTORY_ENABLED=false
# KEYWORD_HISTORY_LOOKBACK_DAYS=3
# EXA_RESET_CIRCUIT_EACH_DISCOVERY=true
# EXA_API_KEY=
# EXA_RESULTS_PER_QUERY=100
# DISCOVERY_REQUIRE_GEO_IN_POST=true
# DISCOVERY_MAX_AGE_DAYS=14
# Unipile inline hybrid (author enrich + rubric before insert)
# DISCOVERY_UNIPILE_INLINE_RUBRIC_ENABLED=true
# DISCOVERY_UNIPILE_INLINE_PATH_A_THRESHOLD=6
# DISCOVERY_UNIPILE_INLINE_PATH_B_THRESHOLD=3
# DISCOVERY_UNIPILE_INLINE_REQUIRE_GEO=true
# Shared atomic profile-fetch budget per slate run (Unipile keyword + APIDirect/Exa enrich).
# DISCOVERY_UNIPILE_MAX_PROFILE_FETCHES_PER_RUN=1500
# DISCOVERY_EXHAUSTION_LEDGER_ENABLED=true
# Per-source wall-clock caps (seconds, 0=off). Prevents keyword sweeps from starving other sources.
# DISCOVERY_WALL_CLOCK_CAP_SECONDS_UNIPILE_KEYWORD=0
# DISCOVERY_WALL_CLOCK_CAP_SECONDS_APIDIRECT=0
# DISCOVERY_WALL_CLOCK_CAP_SECONDS_EXA=0
# DISCOVERY_WALL_CLOCK_CAP_SECONDS_CRUSTDATA_INBOX=0
# DISCOVERY_WALL_CLOCK_CAP_SECONDS_CRUSTDATA_SCREENER=0
# DISCOVERY_UNIPILE_AUTHOR_CACHE_TTL_DAYS=14
# Queue LinkedIn comment when user marks candidate shipped (Celery outbox drain).
# COMMENT_OUTBOX_ON_SHIP_ENABLED=true
# COFOUNDER_DAILY_INITIAL_COMMENT_QUOTA=50
# APIDIRECT_FETCH_REACTION_BREAKDOWN=false
# Contact seeds
# DISCOVERY_CONTACT_SEED_APIDIRECT_PAGES=4
# DISCOVERY_CONTACT_UNIPILE_POSTS_PER_USER=20
# DISCOVERY_CONTACT_UNIPILE_MAX_AGE_DAYS=90
# DISCOVERY_CONTACT_UNIPILE_RUN_POST_QUALITY=false
# PDL_API_KEY=
# ENRICH_WITH_PDL=false
# ENRICH_WITH_CRUSTDATA=true
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_JOBS_DATASET_ID=gd_lpfll7v5hcqtkxl6l
# BRIGHTDATA_POLL_TIMEOUT_S=600
# BRIGHTDATA_POLL_INTERVAL_S=10

# =====================
# Calendly webhooks (Phase 5)
# =====================
CALENDLY_WEBHOOK_BASE_URL=http://localhost:8000/api/webhooks/calendly

# =====================
# Frontend (Next.js)
# =====================
NEXT_PUBLIC_API_URL=http://localhost:8000
